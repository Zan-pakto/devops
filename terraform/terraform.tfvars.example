# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and update with your own environment values.

aws_region           = "ap-south-1"
aws_profile          = "default"
project_name         = "devops-college-project"
vpc_cidr             = "10.0.0.0/16"
subnet_cidr          = "10.0.1.0/24"
my_ip                = "YOUR_PUBLIC_IP/32"
mgmt_instance_type   = "t3.small"
target_instance_type = "t3.micro"
public_key_path      = "./keys/devops-key.pub"
